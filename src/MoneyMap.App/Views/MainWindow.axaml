<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoneyMap.App.ViewModels"
        xmlns:controls="using:MoneyMap.App.Controls"
        xmlns:app="clr-namespace:MoneyMap.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="MoneyMap.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="记账本 - MoneyMap"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Assets/app.ico">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Main Content -->
    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Margin="0,20,0,0">
                    
                    <!-- Navigation Items -->
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🏠" FontSize="16"/>
                            <TextBlock Text="仪表盘" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Transactions">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📋" FontSize="16"/>
                            <TextBlock Text="交易记录" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Import">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📥" FontSize="16"/>
                            <TextBlock Text="导入数据" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Analytics">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📊" FontSize="16"/>
                            <TextBlock Text="分析报表" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Categories">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🏷️" FontSize="16"/>
                            <TextBlock Text="分类管理" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="统计">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📈" FontSize="16"/>
                            <TextBlock Text="统计" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Accounts">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="💳" FontSize="16"/>
                            <TextBlock Text="账户管理" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- Settings at bottom -->
                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                    <Button Classes="NavItem" Command="{Binding NavigateToCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚙️" FontSize="16"/>
                            <TextBlock Text="设置" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="20"/>
        
        <!-- Toast Container - overlay on top -->
        <controls:ToastContainer Grid.ColumnSpan="2" 
                                 DataContext="{x:Static app:App.ToastService}"
                                 IsHitTestVisible="False"/>
    </Grid>

    <Window.Styles>
        <!-- Sidebar Navigation Buttons -->
        <Style Selector="Button.NavItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        
        <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>
        
        <Style Selector="Button.NavItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0E7FF"/>
        </Style>
        
        <Style Selector="Button.NavItem:pointerover">
            <Setter Property="Foreground" Value="#4F46E5"/>
        </Style>
    </Window.Styles>

</Window>
