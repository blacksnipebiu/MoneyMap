<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoneyMap.App.ViewModels.Pages"
             xmlns:enums="using:MoneyMap.Core.Enums"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="MoneyMap.App.Views.Pages.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <Design.DataContext>
        <vm:StatisticsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Bar: Month Navigation + Type Toggle -->
        <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Month Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding ChangeMonthCommand}" CommandParameter="-1"
                            Content="◀" Classes="Secondary" Padding="8,4"/>
                    <TextBlock Text="{Binding SelectedMonth, StringFormat='{}{0:yyyy年MM月}'}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center" MinWidth="120" TextAlignment="Center"/>
                    <Button Command="{Binding ChangeMonthCommand}" CommandParameter="1"
                            Content="▶" Classes="Secondary" Padding="8,4"/>
                </StackPanel>

                <!-- Type Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="支出"
                            Command="{Binding SwitchTypeCommand}"
                            CommandParameter="{x:Static enums:TransactionType.Expense}"
                            Classes="Primary"
                            Padding="16,8"/>
                    <Button Content="收入"
                            Command="{Binding SwitchTypeCommand}"
                            CommandParameter="{x:Static enums:TransactionType.Income}"
                            Classes="Secondary"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl with 3 tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab 1: Summary (PieChart) -->
            <TabItem Header="汇总">
                <Grid RowDefinitions="*,Auto" Margin="0,16,0,0">
                    <!-- PieChart or Empty State -->
                    <Border Grid.Row="0" Classes="Card">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel IsVisible="{Binding !CategorySummaries.Count}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                <TextBlock Text="🥧" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="暂无数据" Classes="Subtitle" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- PieChart -->
                            <lvc:CartesianChart IsVisible="{Binding !!CategorySummaries.Count}"
                                                Series="{Binding PieChartSeries}"
                                                LegendPosition="Right"/>
                        </Grid>
                    </Border>

                    <!-- Category List -->
                    <Border Grid.Row="1" Classes="Card" Margin="0,16,0,0" MaxHeight="300">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding CategorySummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" Width="30"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='¥{0:N2}'}"
                                                       Foreground="#EF4444" Margin="16,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Percentage, StringFormat='{}{0:P0}'}"
                                                       Foreground="Gray" MinWidth="50" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Trend (LineChart) -->
            <TabItem Header="趋势">
                <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <!-- Category Selector -->
                    <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="选择分类：" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding CategorySummaries}"
                                      SelectedItem="{Binding SelectedCategorySummary}"
                                      DisplayMemberBinding="{Binding CategoryName}"
                                      MinWidth="150"/>
                        </StackPanel>
                    </Border>

                    <!-- LineChart or Empty State -->
                    <Border Grid.Row="1" Classes="Card">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel IsVisible="{Binding !TrendData.Count}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="暂无数据" Classes="Subtitle" HorizontalAlignment="Center"/>
                                <TextBlock Text="请先选择分类" Classes="Subtitle" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- LineChart -->
                            <lvc:CartesianChart IsVisible="{Binding !!TrendData.Count}"
                                                Series="{Binding TrendChartSeries}"
                                                XAxes="{Binding TrendXAxes}"
                                                YAxes="{Binding TrendYAxes}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: TopN (BarChart) -->
            <TabItem Header="TopN">
                <Border Classes="Card" Margin="0,16,0,0">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel IsVisible="{Binding !TopCategories.Count}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无数据" Classes="Subtitle" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- BarChart -->
                        <lvc:CartesianChart IsVisible="{Binding !!TopCategories.Count}"
                                            Series="{Binding TopNChartSeries}"
                                            XAxes="{Binding TopNXAxes}"
                                            YAxes="{Binding TopNYAxes}"
                                            LegendPosition="Right"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
