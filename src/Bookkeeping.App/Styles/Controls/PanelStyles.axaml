<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}"/>
        <Setter Property="Padding" Value="{DynamicResource SpacingLg}"/>
    </Style>
    
    <Style Selector="Border.CardHover:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
    </Style>
    
</Styles>
