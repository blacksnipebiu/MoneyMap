<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bookkeeping.App.App"
             xmlns:local="using:Bookkeeping.App"
             xmlns:converters="using:Bookkeeping.App.Converters"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.Resources>
        <converters:TransactionTypeBrushConverter x:Key="TransactionTypeBrushConverter"/>
        <converters:TransactionTypeIconConverter x:Key="TransactionTypeIconConverter"/>
        <converters:TransactionTypeNameConverter x:Key="TransactionTypeNameConverter"/>
        <converters:TransactionTypeColorConverter x:Key="TransactionTypeColorConverter"/>
        <converters:TransactionTypeAmountColorConverter x:Key="TransactionTypeAmountColorConverter"/>
        <converters:SelectionOpacityConverter x:Key="SelectionOpacityConverter"/>
        <converters:TransactionStatusNameConverter x:Key="TransactionStatusNameConverter"/>
        <converters:TransactionStatusColorConverter x:Key="TransactionStatusColorConverter"/>
        <converters:DataSourceIconConverter x:Key="DataSourceIconConverter"/>
        <converters:DataSourceNameConverter x:Key="DataSourceNameConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:HasItemsConverter x:Key="HasItemsConverter"/>
        <converters:IsGreaterThanZeroConverter x:Key="IsGreaterThanZero"/>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>