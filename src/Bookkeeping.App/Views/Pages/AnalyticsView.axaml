<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bookkeeping.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Bookkeeping.App.Views.Pages.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">

    <Design.DataContext>
        <vm:AnalyticsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="分析报表" Classes="Heading" Grid.Column="0"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="1">
                    <DatePicker SelectedDate="{Binding StartDate}"/>
                    <TextBlock Text="至" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding EndDate}"/>
                    <Button Classes="Primary" Content="查询"/>
                </StackPanel>
            </Grid>
            
            <!-- Charts Placeholder -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="Card" Grid.Column="0" Height="300">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="🥧" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="分类占比" Classes="Title" HorizontalAlignment="Center"/>
                        <TextBlock Text="导入数据后显示图表" Classes="Subtitle" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Classes="Card" Grid.Column="1" Height="300">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="收支趋势" Classes="Title" HorizontalAlignment="Center"/>
                        <TextBlock Text="导入数据后显示图表" Classes="Subtitle" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>

