<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bookkeeping.App.ViewModels"
             x:Name="ImportViewRoot"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Bookkeeping.Core.Models"
             xmlns:enums="using:Bookkeeping.Core.Enums"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Bookkeeping.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">

    <Design.DataContext>
        <vm:ImportViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="导入数据" Classes="Heading" Margin="0,0,0,20"/>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- File Selection Section -->
            <ScrollViewer IsVisible="{Binding !IsMappingStep}">
                <StackPanel Spacing="20" Margin="0,0,0,20">
                    <!-- Drop Zone -->
                    <Border x:Name="DropZone" Classes="Card" MinHeight="200"
                            BorderBrush="{DynamicResource PrimaryBrush}" 
                            BorderThickness="2" Background="Transparent"
                            DragDrop.AllowDrop="True">
                        <Grid>
                            <!-- Normal state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                        IsVisible="{Binding !IsDragOver}">
                                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="拖拽文件到此处，或点击选择文件" 
                                           Classes="Title" HorizontalAlignment="Center"/>
                                <TextBlock Text="支持支付宝CSV、微信Excel格式" 
                                           Classes="Subtitle" HorizontalAlignment="Center"/>
                                <Button Classes="Primary" Content="选择文件" Command="{Binding SelectFileCommand}"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <!-- Drag over state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                        IsVisible="{Binding IsDragOver}">
                                <TextBlock Text="📥" FontSize="56" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="释放以导入文件" 
                                           Classes="Title" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="支持 CSV、XLSX、XLS 格式" 
                                           Classes="Subtitle" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Selected File Info -->
                    <Border Classes="Card" IsVisible="{Binding HasFile}">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Border Grid.Column="0" Grid.RowSpan="3" Background="#EEF2FF" 
                                    CornerRadius="8" Width="48" Height="48" Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding FileName}" 
                                       FontWeight="SemiBold" FontSize="14"/>
                            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <TextBlock Text="{Binding FileSize}" Classes="Caption"/>
                                <TextBlock Text="{Binding DetectedSource, StringFormat='来源：{0}'}" 
                                           Classes="Caption" IsVisible="{Binding DetectedSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SelectedFilePath}" 
                                       Classes="Caption" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.6"/>
                            <Button Grid.Column="2" Grid.RowSpan="3" Classes="Secondary" 
                                    Content="清除" Command="{Binding ClearFileCommand}"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsImporting, Converter={x:Static BoolConverters.Not}}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Parse Button -->
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasFile}">
                        <Button Classes="Primary" Content="解析文件" Command="{Binding ParseFileCommand}"
                                IsEnabled="{Binding IsParsing, Converter={x:Static BoolConverters.Not}}"/>
                        <Button Classes="Secondary" Content="重新选择" Command="{Binding ClearFileCommand}"
                                IsEnabled="{Binding IsParsing, Converter={x:Static BoolConverters.Not}}"/>
                    </StackPanel>
                    
                    <!-- Parsing Progress -->
                    <Border Classes="Card" IsVisible="{Binding IsParsing}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding ImportStatus}" FontWeight="Medium"/>
                            <ProgressBar Value="{Binding ImportProgress}" Maximum="100" 
                                         Height="6" CornerRadius="3" IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Mapping Step -->
            <Border Classes="Card" IsVisible="{Binding IsMappingStep}" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="字段映射" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Grid.Row="1" Text="检查来源字段到我们系统的映射关系，调整分类映射后确认继续"
                               Classes="Caption" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- Tab-like selector -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Classes="Primary" Content="分类映射" FontSize="13" Padding="12,6"
                                Command="{Binding ShowCategoryMappingCommand}"/>
                        <Button Classes="Secondary" Content="字段映射" FontSize="13" Padding="12,6"
                                Command="{Binding ShowFieldMappingCommand}"/>
                        <Button Classes="Secondary" Content="类型/状态映射" FontSize="13" Padding="12,6"
                                Command="{Binding ShowStatusMappingCommand}"/>
                        <Button Classes="Secondary" Content="支付方式映射" FontSize="13" Padding="12,6"
                                Command="{Binding ShowPaymentMethodMappingCommand}"/>
                    </StackPanel>

                    <!-- Mapping panels container (scrollable) -->
                    <ScrollViewer Grid.Row="3">
                        <StackPanel Spacing="16" Margin="0,16,0,0">

                            <!-- Category Mapping Panel -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="8" Padding="16" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding IsShowingCategoryMapping}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Width="24"/>
                                        <TextBlock Grid.Column="1" Text="来源分类" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Grid.Column="2" Text="数量" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="→ 映射到" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Grid.Column="4" Text="" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CategoryMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,4">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0"
                                                              VerticalAlignment="Center" IsVisible="{Binding !IsMapped}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Background="{Binding SuggestedType, Converter={StaticResource TransactionTypeColorConverter}}"
                                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding SuggestedType, Converter={StaticResource TransactionTypeNameConverter}}"
                                                                       FontSize="11" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SourceCategory}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Opacity="0.7"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="3" 
                                                              ItemsSource="{Binding AvailableCategories}"
                                                              SelectedItem="{Binding SelectedCategory}"
                                                              HorizontalAlignment="Stretch" MinWidth="140"
                                                              PlaceholderText="选择分类">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate DataType="models:Category">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="4" Classes="Secondary" Content="新建" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                                            Command="{Binding #ImportViewRoot.DataContext.CreateCategoryFromMappingCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Batch apply bar -->
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Button Grid.Column="0" Classes="Secondary" Content="全选/取消" FontSize="12" Padding="8,4"
                                                    Command="{Binding #ImportViewRoot.DataContext.ToggleSelectAllCategoryMappingsCommand}"/>
                                            <Button Grid.Column="1" Classes="Accent" Content="一键新建所有" FontSize="12" Padding="8,4" Margin="6,0,0,0"
                                                    Command="{Binding #ImportViewRoot.DataContext.BatchCreateAllCategoriesCommand}"/>
                                            <TextBlock Grid.Column="2" Text="批量映射：" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCategories}"
                                                      SelectedItem="{Binding BatchTargetCategory}"
                                                      MinWidth="140" PlaceholderText="选择目标分类">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="models:Category">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="4" Classes="Accent" Content="批量应用" FontSize="12" Padding="8,4" Margin="8,0,0,0"
                                                    Command="{Binding #ImportViewRoot.DataContext.BatchApplyCategoryCommand}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CategoryMappings.Count, StringFormat='共 {0} 个来源分类'}" 
                                                   Classes="Caption" Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Field Mapping Panel -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="8" Padding="16" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding IsShowingFieldMapping}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="来源字段" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="→" FontWeight="SemiBold" FontSize="12" Opacity="0.5" Margin="16,0"/>
                                        <TextBlock Grid.Column="2" Text="系统字段" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="3" Text="示例数据" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FieldMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding SourceField}" FontSize="12" Width="100"/>
                                                    <TextBlock Grid.Column="1" Text="→" FontSize="12" Opacity="0.5" Margin="16,0"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding TargetDisplayName}" FontSize="12" FontWeight="Medium"/>
                                                        <TextBlock Text="✓" FontSize="11" Foreground="#10B981" IsVisible="{Binding IsMapped}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding SampleData}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Type/Status Mapping Panel -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="8" Padding="16" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding IsShowingStatusMapping}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" Text="类型" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Width="60"/>
                                        <TextBlock Grid.Column="1" Text="来源值" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Grid.Column="2" Text="→ 映射到" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="16,0"/>
                                        <TextBlock Grid.Column="3" Text="标准值" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TypeStatusMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,2">
                                                    <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding MappingKind}" FontSize="11" Foreground="#4F46E5"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding SourceValue}" FontSize="12"/>
                                                    <TextBlock Grid.Column="2" Text="→" FontSize="12" Opacity="0.5" Margin="16,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TargetValue}" FontSize="12" FontWeight="Medium"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Payment Method Mapping Panel -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="8" Padding="16" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding IsShowingPaymentMethodMapping}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="相似支付方式已自动分组，可批量映射到同一账户" 
                                               FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding PaymentMethodGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                                                        CornerRadius="6" Padding="8" Margin="0,4">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                                            <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsExpanded}" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}共 {0} 项 · {1} 笔">
                                                                        <Binding Path="Items.Count" />
                                                                        <Binding Path="TotalCount" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <ComboBox Grid.Column="3" ItemsSource="{Binding #ImportViewRoot.DataContext.Accounts}"
                                                                      SelectedItem="{Binding GroupTargetAccount}"
                                                                      MinWidth="140" PlaceholderText="选择账户" HorizontalAlignment="Right">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="models:Account">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                                                            <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.6"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="4" Classes="Accent" Content="组内全部映射" FontSize="11" Padding="6,3" Margin="4,0,0,0"
                                                                    Command="{Binding #ImportViewRoot.DataContext.BatchApplyPaymentMethodGroupCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                        <StackPanel Spacing="2" IsVisible="{Binding IsExpanded}">
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SourcePaymentMethod}" FontSize="12"/>
                                                                                <TextBlock Text="✓" FontSize="10" Foreground="#10B981" IsVisible="{Binding IsMapped}" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Opacity="0.6"
                                                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                            <ComboBox Grid.Column="2" 
                                                                                      ItemsSource="{Binding AvailableAccounts}"
                                                                                      SelectedItem="{Binding SelectedAccount}"
                                                                                      HorizontalAlignment="Stretch" MinWidth="140"
                                                                                      PlaceholderText="选择账户">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate DataType="models:Account">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                                                                            <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.6"/>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding PaymentMethodMappings.Count, StringFormat='共 {0} 种支付方式'}" 
                                                   Classes="Caption" Opacity="0.6" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PaymentMethodGroups.Count, StringFormat='（分为 {0} 组）'}" 
                                                   Classes="Caption" Opacity="0.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="未映射的支付方式将使用默认账户" 
                                                   Classes="Caption" Opacity="0.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Fixed bottom buttons -->
                    <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" 
                            Padding="0,16,0,0" Margin="0,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Classes="Secondary" Content="取消" 
                                    Command="{Binding ClearFileCommand}"
                                    IsEnabled="{Binding IsParsing, Converter={x:Static BoolConverters.Not}}"/>
                            <Button Classes="Primary" Content="确认映射，继续预览" 
                                    Command="{Binding ConfirmMappingCommand}"
                                    IsEnabled="{Binding IsParsing, Converter={x:Static BoolConverters.Not}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Create Account Dialog Overlay -->
        <Border IsVisible="{Binding ShowCreateAccountDialog}"
                Background="#80000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12" Padding="24" Width="400"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="创建新账户" FontWeight="SemiBold" FontSize="18"/>
                    <TextBox Text="{Binding NewAccountName}" PlaceholderText="账户名称"/>
                    <ComboBox ItemsSource="{Binding Source={x:Static enums:DataSourceHelper.AllSources}}"
                              SelectedItem="{Binding NewAccountSource}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Converter={StaticResource DataSourceIconConverter}}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Converter={StaticResource DataSourceNameConverter}}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Classes="Secondary" Content="取消" Command="{Binding CancelCreateAccountCommand}"/>
                        <Button Classes="Primary" Content="创建" Command="{Binding CreateAccountCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</UserControl>