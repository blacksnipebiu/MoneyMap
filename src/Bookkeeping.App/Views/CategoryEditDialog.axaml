<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bookkeeping.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="380"
        x:Class="Bookkeeping.App.Views.CategoryEditDialog"
        x:DataType="vm:CategoryEditViewModel"
        Title="添加分类"
        Width="400" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:CategoryEditViewModel/>
    </Design.DataContext>

    <Border Classes="Card" Margin="16">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       Classes="Title"
                       Margin="0,0,0,16"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="16">
                    <!-- Name -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="分类名称" Classes="Label"/>
                        <TextBox Text="{Binding Name}"
                                 PlaceholderText="输入分类名称"
                                 MaxLength="20"
                                 Width="300"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Type (only enabled in add mode) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="分类类型" Classes="Label"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton GroupName="CategoryType"
                                         Content="支出"
                                         IsEnabled="{Binding !IsEditMode}"
                                         IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Expense}"/>
                            <RadioButton GroupName="CategoryType"
                                         Content="收入"
                                         IsEnabled="{Binding !IsEditMode}"
                                         IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Income}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Icon -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="图标" Classes="Label"/>
                        <Button Classes="Secondary" Padding="12" HorizontalAlignment="Left"
                                Click="OnSelectIconClick" ToolTip.Tip="点击选择图标">
                            <TextBlock Text="{Binding SelectedIcon}" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Sort Order (read-only, edit mode only) -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsEditMode}">
                        <TextBlock Text="排序顺序" Classes="Label"/>
                        <TextBlock Text="{Binding SortOrder}" Classes="Caption"/>
                    </StackPanel>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="Secondary" Content="取消" Click="OnCancelClick"/>
                <Button Classes="Primary" Content="确认" Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>